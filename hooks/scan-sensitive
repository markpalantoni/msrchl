#!/usr/bin/env bash
# This repo is public. Refuse any commit or push whose tree carries secrets or
# personal data. pre-commit scans the index; pre-push scans every commit going out.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

FORBIDDEN_FILES='(^|/)(\.env[^/]*|.*\.(pem|key|p12|pfx|jks|keystore)|id_(rsa|ed25519|ecdsa)[^/]*|credentials\.json|token\.json|service-account[^/]*\.json)$'
SECRETS=(
  -e 'AKIA[0-9A-Z]{16}'                          # AWS
  -e 'AIza[0-9A-Za-z_-]{35}'                      # Google API key
  -e 'gh[pousr]_[A-Za-z0-9]{36}'                  # GitHub token
  -e 'github_pat_[A-Za-z0-9_]{20,}'
  -e 'xox[abprs]-[A-Za-z0-9-]{10,}'               # Slack
  -e 'sk-(ant-)?[A-Za-z0-9_-]{20,}'               # OpenAI / Anthropic
  -e 'BEGIN [A-Z ]*PRIVATE KEY'
  -e 'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}' # JWT
)
PERSONAL=(
  -e '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'                     # email
  -e '(^|[^0-9])(\(?[0-9]{3}\)?[-. ])[0-9]{3}[-. ][0-9]{4}([^0-9]|$)'     # phone
  -e '/Users/[A-Za-z0-9._-]+|/home/[A-Za-z0-9._-]+'                       # home paths
  -e '(^|[^0-9.])(10|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]+\.[0-9]+' # private IPs
  -e '(api[_-]?key|secret|token|passw(or)?d|bearer)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{6,}'
)

fail=0
scan_tree() {                       # $1 = tree-ish, or --cached for the index
  local t=$1 label=$2 out
  out=$(git ls-tree -r --name-only "$t" 2>/dev/null || git ls-files --cached)
  out=$(grep -E "$FORBIDDEN_FILES" <<<"$out" || true)
  [[ -n "$out" ]] && { echo "$label: forbidden file names:"; sed 's/^/  /' <<<"$out"; fail=1; }
  out=$(git grep -n -I -E "${SECRETS[@]}" "$t" -- . 2>/dev/null || true)
  [[ -n "$out" ]] && { echo "$label: possible credential:"; sed 's/^/  /' <<<"$out"; fail=1; }
  out=$(git grep -n -I -i -E "${PERSONAL[@]}" "$t" -- . 2>/dev/null || true)
  [[ -n "$out" ]] && { echo "$label: possible personal data:"; sed 's/^/  /' <<<"$out"; fail=1; }
}

case "$(basename "$0")" in
  pre-commit)
    scan_tree --cached "staged tree"
    email=$(git config user.email || true)
    if [[ "$email" == *@consensus.app ]]; then
      echo "author email $email is a work address; this repo is public. Run:"
      echo "  git config user.email <personal address>"
      fail=1
    fi ;;
  pre-push)
    while read -r _ local_sha _ remote_sha; do
      [[ "$local_sha" =~ ^0+$ ]] && continue
      if [[ "$remote_sha" =~ ^0+$ ]]; then range=$local_sha; else range="$remote_sha..$local_sha"; fi
      for c in $(git rev-list "$range"); do
        scan_tree "$c" "commit ${c:0:7}"
        ae=$(git log -1 --format=%ae "$c")
        [[ "$ae" == *@consensus.app ]] && { echo "commit ${c:0:7} is authored as $ae (work address)"; fail=1; }
      done
    done ;;
  *) scan_tree HEAD "HEAD" ;;
esac

if (( fail )); then
  echo
  echo "Blocked: this repo is public. Remove or reword the lines above; there is no bypass."
  exit 1
fi
